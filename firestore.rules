rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for User Profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for CMS Tasks
    match /cms_tasks/{taskId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Rules for Scheduled Videos
    match /scheduled_videos/{videoId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Rules for YouTube Tokens
    match /youtube_tokens/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Rules for Ideas State
    match /ideas_state/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Rules for Idea Snapshots
    match /idea_snapshots/{snapshotId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Rules for History Items
    match /history/{historyId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Rules for Script States
    match /script_states/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Rules for Script Versions
    match /script_versions/{versionId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Default deny for all other paths
    match /{path=**} {
      allow read, write: if false;
    }
  }
}

